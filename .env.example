# Symcio Landing — environment variables（Vercel Project Settings 設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 公開可暴露給前端的 anon key（如未來改用 client-side insert 才會用到）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# 網站正式網域（success_url / 電子書下載連結會用到）
NEXT_PUBLIC_SITE_URL=https://symcio.tw

# Stripe Payment Links（填入後 /api/checkout 直接轉址、零 API 呼叫、<0.2s）
STRIPE_AUDIT_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_OPTIMIZATION_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_EBOOK_PAYMENT_LINK=https://buy.stripe.com/...

# 或改用 Stripe Price ID（走 sessions.create 流程的後援）
STRIPE_AUDIT_PRICE_ID=price_...
STRIPE_OPTIMIZATION_PRICE_ID=price_...
STRIPE_EBOOK_PRICE_ID=price_...

# BCI 電子書 PDF 的下載網址（建議用 Supabase Storage 簽章網址或私有 CDN）
BCI_EBOOK_DOWNLOAD_URL=https://your-storage/bci-methodology.pdf

# 綠界 ECPay 台灣金流（收台幣：信用卡 / ATM / 超商）
# 測試特店：MerchantID=2000132，stage 模式；正式上線改 prod 並換成你的特店資料
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_MODE=stage

# 社群自動化 — LINE 官方帳號（Messaging API）
# Webhook URL 設為 https://symcio.tw/api/line/webhook
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...

# 社群自動化 — Telegram Bot
# Webhook 設為 https://symcio.tw/api/telegram/webhook（secret_token 選填）
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# 社群自動化 — Meta（Messenger / Instagram）
# Webhook URL https://symcio.tw/api/meta/webhook，驗證用 META_VERIFY_TOKEN
META_VERIFY_TOKEN=choose-any-string
META_APP_SECRET=...
META_PAGE_ACCESS_TOKEN=...
