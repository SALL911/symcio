# Symcio Landing — environment variables（Vercel Project Settings 設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 公開可暴露給前端的 anon key（如未來改用 client-side insert 才會用到）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# ---------------------------------------------------------------------------
# /api/send-email — 讓 AI / 自動化用 @symcio.tw 寄信，且寄件備份同步到所有裝置
# 設定教學見 docs/email-gmail-api.md
# ---------------------------------------------------------------------------

# 端點存取金鑰（自行產生一串夠長的隨機字串；呼叫時帶 header x-api-key）
SEND_EMAIL_API_KEY=change-me-to-a-long-random-string

# 允許從哪些信箱寄出（逗號分隔，防止他人冒名）
SEND_EMAIL_ALLOWED_SENDERS=info@symcio.tw,sall@symcio.tw

# === 供應商 A【@symcio.tw 推薦】Microsoft 365 / Outlook (Microsoft Graph) ===
# info@symcio.tw 實際在 Microsoft 365；用 Graph 寄信會存進 Outlook 寄件備份，
# 手機/桌機 Outlook 自動同步。需 Azure AD app（application 權限 Mail.Send + admin consent）。
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# === 供應商 B Google Workspace / Gmail (Gmail API)（與 A 可並存，擇你需要的）===
# 方式一【推薦】Service Account + 網域委派：整段 service-account JSON 壓成一行
# GMAIL_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# 方式二【備用】單一信箱 OAuth refresh token
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
