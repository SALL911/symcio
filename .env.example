# Symcio Landing — environment variables（Vercel Project Settings 設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 公開 anon key：會員登入 / 註冊（@supabase/ssr）必填
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

NEXT_PUBLIC_SITE_URL=https://symcio.tw

# ---------- 社群 / LINE 官方帳號 ----------
# LINE Official Account Manager → 帳號設定 → 基本 ID（含 @）。未設定時網站不顯示 LINE 入口
NEXT_PUBLIC_LINE_OA_ID=@your-line-id
# LINE Developers → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- 會員同步 ----------
# HubSpot Private App（scopes: crm.objects.contacts.read/write, crm.schemas.contacts.write）
HUBSPOT_PRIVATE_APP_TOKEN=
# Notion internal integration + 會員資料庫（需把 integration 加入資料庫 Connections）
NOTION_API_KEY=
NOTION_MEMBERS_DB_ID=
# Obsidian vault 的 private GitHub repo（Obsidian Git 外掛 pull）
OBSIDIAN_VAULT_REPO=owner/obsidian-vault
OBSIDIAN_VAULT_TOKEN=
OBSIDIAN_VAULT_DIR=Symcio/Members

# ---------- 電子報 ----------
RESEND_API_KEY=
NEWSLETTER_FROM=Symcio 週報 <newsletter@symcio.tw>
# 退訂 / 確認連結 HMAC 金鑰（openssl rand -base64 32）。更換會讓舊信連結失效
NEWSLETTER_SECRET=
# 每次 cron 最多寄出的「確認訂閱」邀請數（保護寄件網域信譽，建議 100–300）
NEWSLETTER_INVITE_CAP=200
# Vercel Cron 會自動帶 Authorization: Bearer $CRON_SECRET
CRON_SECRET=
