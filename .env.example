# Symcio Landing — environment variables（Vercel Project Settings 設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 公開可暴露給前端的 anon key（如未來改用 client-side insert 才會用到）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# 網站正式網域（success_url / 電子書下載連結會用到）
NEXT_PUBLIC_SITE_URL=https://symcio.tw

# Stripe Payment Links（填入後 /api/checkout 直接轉址、零 API 呼叫、<0.2s）
STRIPE_AUDIT_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_OPTIMIZATION_PAYMENT_LINK=https://buy.stripe.com/...
STRIPE_EBOOK_PAYMENT_LINK=https://buy.stripe.com/...

# 或改用 Stripe Price ID（走 sessions.create 流程的後援）
STRIPE_AUDIT_PRICE_ID=price_...
STRIPE_OPTIMIZATION_PRICE_ID=price_...
STRIPE_EBOOK_PRICE_ID=price_...

# BCI 電子書 PDF 的下載網址（建議用 Supabase Storage 簽章網址或私有 CDN）
BCI_EBOOK_DOWNLOAD_URL=https://your-storage/bci-methodology.pdf

# 綠界 ECPay 台灣金流（收台幣：信用卡 / ATM / 超商）
# 測試特店：MerchantID=2000132，stage 模式；正式上線改 prod 並換成你的特店資料
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_MODE=stage

# 社群自動化 — LINE 官方帳號（Messaging API）
# Webhook URL 設為 https://symcio.tw/api/line/webhook
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...

# PayPal 金流（海外/信用卡；TWD 無小數）
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
PAYPAL_MODE=sandbox

# 台灣電子書平台上架連結（無 API，於後台上架後把商品頁網址填這裡，前端會顯示購買連結）
NEXT_PUBLIC_EBOOK_PUBU_URL=
NEXT_PUBLIC_EBOOK_READMOO_URL=

# 社群自動化 — Telegram Bot
# Webhook 設為 https://symcio.tw/api/telegram/webhook（secret_token 選填）
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# 社群自動化 — Meta（Messenger / Instagram）
# Webhook URL https://symcio.tw/api/meta/webhook，驗證用 META_VERIFY_TOKEN
META_VERIFY_TOKEN=choose-any-string
META_APP_SECRET=...
META_PAGE_ACCESS_TOKEN=...

# 新名單通知信收件人（預設 info@symcio.tw）。Supabase 沒設定時，這封信是名單的唯一紀錄
LEAD_NOTIFY_EMAIL=info@symcio.tw

# Meta Pixel + Conversions API
# Pixel ID 為公開識別碼；token 從 Events Manager → 資料來源 → 設定 → 轉換 API → 產生存取權杖
NEXT_PUBLIC_META_PIXEL_ID=2383984185680148
META_CAPI_ACCESS_TOKEN=...
# 只在測試時設定（Events Manager「測試事件」分頁的代碼），正式環境留空
META_CAPI_TEST_EVENT_CODE=

# Email 行銷平台 — Kit (ConvertKit)
# 10,000 subscribers 免費方案。拿 API key 從 Kit → Settings → Developer。
# KIT_FORM_ID 選填：有填就訂進那個 form，沒填就建立 generic subscriber。
KIT_API_KEY=...
KIT_FORM_ID=

# ── AI 自動獲客成交系統 ─────────────────────────────────────────
# AI 模組（名單分級、私訊自動回覆）。沿用 Gemini；未設定時改用規則分級與固定範本。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 私訊 AI 回覆總開關。設 false 立即退回固定範本（出問題時的緊急煞車）。
AI_REPLY_ENABLED=true

# 內部後台 /admin（漏斗看板、名單管理）。兩個都要設，否則後台關閉（503）。
ADMIN_USER=
ADMIN_PASSWORD=

# 跟進信排程。CRON_SECRET 在 Vercel 設定後，Vercel Cron 會自動帶入 Authorization。
CRON_SECRET=
# D2 / D5 行銷跟進信。預設關閉：先把表單同意文字改為涵蓋後續聯絡（需律師確認）再開。
# D0 確認信不受此開關影響，一律寄出。
FOLLOWUP_SEQUENCE_ENABLED=false

# 看板把美元訂單換算成新台幣的匯率
USD_TWD_RATE=32

# ── Compliance Pre-Audit（/tools/compliance-audit）──────────────
# 未設定時回傳固定的框架對照表，不呼叫 AI。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
