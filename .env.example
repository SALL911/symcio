# Symcio Landing — environment variables（Vercel Project Settings 設定）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 公開可暴露給前端的 anon key（如未來改用 client-side insert 才會用到）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# ── SEO / GEO tooling ─────────────────────────────
# Google Search Console 驗證碼（HTML tag 方式的 content 值）。設定後 layout 自動輸出 <meta name="google-site-verification">
NEXT_PUBLIC_GSC_VERIFICATION=
# 本機 Claude Code 用：GSC service account JSON 金鑰的絕對路徑（.mcp.json 的 gsc server 讀取）。金鑰放 repo 外。
GSC_CREDENTIALS_PATH=
