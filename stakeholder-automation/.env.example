# --- Gmail / Google Workspace (info@symcio.tw) ---
# Drafts are CREATED, never sent. OAuth2 with a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Account where drafts are stored for your review (per request: info@symcio.tw)
GMAIL_USER=info@symcio.tw
# Address the email should appear to come FROM when you manually send it
SENDER_FROM=sall@symcio.tw

# --- Safety ---
# Set to "false" ONLY when you intend to create real Gmail drafts.
DRY_RUN=true

# --- OPTIONAL: Microsoft Graph (Outlook) draft creation. Leave blank to skip. ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_USER=info@symcio.tw
