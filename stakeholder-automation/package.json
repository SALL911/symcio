{
  "name": "symcio-stakeholder-automation",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Weekly stakeholder digest -> Gmail drafts (draft-only, never auto-sends). Pulls from lib/news-data.ts + weekly-update.md.",
  "scripts": {
    "digest": "tsx src/digest.ts",
    "drafts": "tsx src/createDrafts.ts",
    "drafts:dry": "cross-env DRY_RUN=true tsx src/createDrafts.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
